{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Mean with Std Dev Shading",
  "data": {"name": "wandb"},
  "layer": [
    {
      "mark": {"type": "area", "opacity": 0.3},
      "encoding": {
        "x": {"field": "${field:step}", "type": "quantitative", "title": "Update"},
        "y": {"field": "${field:lower_std}", "type": "quantitative", "title": "mean +- std"},
        "y2": {"field": "${field:upper_std}"},
        "color": {"value": "#4BA6E8"}
      }
    },
    {
      "mark": {"type": "line"},
      "encoding": {
        "x": {"field": "${field:step}", "type": "quantitative", "title": "Update"},
        "y": {"field": "${field:mean}", "type": "quantitative", "title": "mean +- std"},
        "color": {"value": "#4BA6E8"}
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "center",
        "fontSize": 14,
        "fontWeight": "bold"
      },
      "encoding": {
        "x": {"aggregate": "mean", "field": "${field:step}", "type": "quantitative"},
        "y": {"value": 10},
        "text": {"aggregate": "min", "field": "${field:label}", "type": "nominal"}
      }
    }
  ]
}
