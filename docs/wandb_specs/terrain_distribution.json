{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Stacked Area Chart for Terrain Distributions",
  "title": "Terrain Distribution",
  "data": {"name": "wandb"},
  "mark": {"type": "area", "line": true},
  "encoding": {
    "x": {"field": "${field:step}", "type": "quantitative", "title": "Update"},
    "y": {
      "field": "${field:fraction}",
      "type": "quantitative",
      "aggregate": "sum",
      "title": "Visit Fraction"
    },
    "color": {
      "field": "${field:terrain}",
      "type": "nominal",
      "scale": {
        "domain": ["ocean", "deep_water", "water", "beach", "sandy", "grassland", "forest", "rocky", "mountains"],
        "range": ["#0523E1", "#1941E1", "#4169E1", "#EED6AF", "#D2B48C", "#228B22", "#006400", "#8B8989", "#FFFAFA"]
      }
    },
    "order": {"field": "${field:terrain_idx}", "type": "quantitative"}
  }
}
